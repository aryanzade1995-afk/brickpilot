# Client-side env (Vite inlines VITE_* at build time). Copy to .env.local and fill in.
# .env.local is gitignored. In production (Render) set these in the dashboard.
#
# Accounts + synced saved designs (Supabase). Optional — with these blank the app
# still runs, it just can't sign anyone in or save designs to an account.
# Get both from your Supabase project → Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
