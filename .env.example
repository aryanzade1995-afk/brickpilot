# Client-side env (Vite inlines VITE_* at build time). Copy to .env.local and fill in.
# .env.local is gitignored. In production (Render) set these in the dashboard.
#
# Accounts + synced saved designs (Supabase). Optional — with these blank the app
# still runs, it just can't sign anyone in or save designs to an account.
# Get both from your Supabase project → Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Server-side Cost Research & Ollama Configuration
# -----------------------------------------------------------------------------
# Enables real-time regional construction & interior price evidence extraction.
# When false/omitted, the app defaults to the baseline concept rate book (Pune 2026-10-03).
COST_RESEARCH_ENABLED=true

# Local or operator-managed Ollama inference endpoint.
# Local development: http://127.0.0.1:11434 (runs Ollama locally)
# Production/Hosted (Render/Cloud): configure an authenticated operator endpoint, e.g. https://ollama.internal.yourdomain.com
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Exact language model used for extracting and explaining price evidence from fetched text.
# The application uses deterministic code for all measurements, conversions, and totals.
OLLAMA_MODEL=qwen3.5:2b

# Optional Bearer token / API key for authenticated hosted Ollama instances.
# Never expose this key in client-side code, VITE_* variables, or responses.
OLLAMA_API_KEY=

# Bounded timeouts and concurrency controls for web search and LLM extraction
COST_RESEARCH_TIMEOUT_MS=60000
COST_RESEARCH_MAX_CONCURRENCY=2
COST_RESEARCH_CACHE_TTL_HOURS=24

# Set to 'true' in development/test environments without internet or Ollama to use fixed fixtures
# COST_RESEARCH_MOCK=false

