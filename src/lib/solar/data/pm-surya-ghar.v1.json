    {"id": "residential-connection", "source": "residential-guidelines", "section": "5(b,d)", "summary": "CFA is for eligible residential grid-connected consumers; non-residential segments are excluded."},
    {"id": "dcr", "source": "residential-guidelines", "section": "5(m)", "summary": "CFA requires domestically manufactured modules made with domestically manufactured cells; non-DCR equipment is not eligible."},
    {"id": "technical", "source": "july-2025-amendment", "section": "6(f), Annexure 3", "summary": "Check current MNRE technical specifications, applicable ALMM requirements, exact equipment and vendor/DISCOM acceptance; illustrative models are not certified eligible."},
    {"id": "previous-cfa", "source": "residential-guidelines", "section": "5(n,o)", "summary": "Earlier subsidized capacity affects any incremental claim; relocation does not create a new CFA entitlement."},
    {"id": "vendor-portal", "source": "residential-guidelines", "section": "6(a,c)", "summary": "Use the National Portal and a vendor registered there; inspection and commissioning precede the applicable claim process."},
    {"id": "state-separate", "source": "july-2025-amendment", "section": "5(i)", "summary": "Any state/UT support is separate and should be updated on the National Portal; it is not automatically added to central assistance."}
