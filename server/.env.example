# Copy to server/.env and fill in. server/.env is gitignored.
# In production (Render) set these in the dashboard Environment tab instead.

# ---- Step 5 building concepts (Gemini image edit) ----
# Google AI Studio key for Gemini 2.5 Flash Image ("Nano Banana"), free tier:
# https://aistudio.google.com/apikey
# Without it the render step still works — it echoes the massing reference.
GEMINI_API_KEY=

# Optional overrides
# RENDER_MODEL=gemini-2.5-flash-image
# RENDER_PROXY_PORT=8787          # local only; Render injects PORT itself
# RENDER_MOCK=1                   # skip the API and echo the massing reference

# ---- AI interior render (SDXL + ControlNet) ----
# Which backend generates interiors: comfyui | gemini | mock
# Default comfyui; auto-falls back to mock when ComfyUI is unreachable.
INTERIOR_PROVIDER=comfyui

# Local ComfyUI (https://github.com/comfyanonymous/ComfyUI)
COMFYUI_URL=http://127.0.0.1:8188

# Model file names as they appear in ComfyUI's models/ folders — adjust to
# whatever you have installed.
SDXL_CKPT=sd_xl_base_1.0.safetensors
CN_DEPTH_MODEL=control-lora-depth-rank256.safetensors
CN_CANNY_MODEL=control-lora-canny-rank256.safetensors

# Sampling (all optional). Defaults suit a standard SDXL finetune; for a
# Lightning/Turbo checkpoint use ~8 steps, cfg ~2, sampler dpmpp_sde.
# INTERIOR_STEPS=28
# INTERIOR_CFG=6.5
# INTERIOR_DENOISE=0.75          # img2img strength on the 3D render (0=keep, 1=free)
# INTERIOR_SAMPLER=dpmpp_2m_sde
# INTERIOR_SCHEDULER=karras
# CN_DEPTH_STR=0.85
# CN_CANNY_STR=0.55
