# Copy to server/.env and fill in. server/.env is gitignored.
# In production (Render) set these in the dashboard Environment tab instead.

# ---- Building concepts ----
# Always: Gemini Web -> ComfyUI -> clearly labelled mock/source preview.
# Building concepts do not require an official Gemini API key.
# RENDER_PROXY_PORT=8787          # local only; production injects PORT

# Optional key only for the legacy official `gemini` interior provider:
GEMINI_API_KEY=

# ---- Inspiration image analysis and AI interiors ----
# Run ntthanh2603/gemini-web-to-api locally (its own cookie configuration
# stays in that service; never put Google cookies in this project).
# The bridge needs no Gemini API key in Formstead.
GEMINI_WEB_URL=http://127.0.0.1:4981
# GEMINI_WEB_MODEL=                 # optional ID from GET /openai/v1/models
# GEMINI_WEB_IMAGE_MODEL=           # optional image-capable ID from that list

# Local ComfyUI (SDXL) is primary for interiors and renders, Gemini Web is the fallback. Other
# explicit choices: comfyui | gemini (official API) | mock.
INTERIOR_PROVIDER=comfyui

# Local ComfyUI (https://github.com/comfyanonymous/ComfyUI)
COMFYUI_URL=http://127.0.0.1:8188

# Model file names as they appear in ComfyUI's models/ folders — adjust to
# whatever you have installed.
SDXL_CKPT=sd_xl_base_1.0.safetensors
CN_CANNY_MODEL=control-lora-canny-rank256.safetensors

# Sampling (all optional). The workflow is txt2img: the room is generated
# furnished from the prompt while a single Canny ControlNet on the edge map
# holds the wall + opening lines. Keeping the ControlNet strength moderate
# (and releasing it ~55% through) lets the furniture actually form instead
# of collapsing back to an empty box.
#
# Standard SDXL finetune (Juggernaut XL, RealVisXL):
#   INTERIOR_STEPS=24  INTERIOR_CFG=6  INTERIOR_SAMPLER=dpmpp_2m_sde
# Lightning / Turbo SDXL (RealVisXL Lightning, DreamShaper Turbo):
#   INTERIOR_STEPS=8   INTERIOR_CFG=2.6  INTERIOR_SAMPLER=dpmpp_sde
#
# INTERIOR_STEPS=8
# INTERIOR_CFG=2.6
# INTERIOR_DENOISE=1.0
# INTERIOR_SAMPLER=dpmpp_sde
# INTERIOR_SCHEDULER=karras
# INTERIOR_WIDTH=1024
# INTERIOR_HEIGHT=768
# CN_CANNY_STR=0.62  CN_CANNY_END=0.55

# Local procedural Blender pipeline (Node.js 24+). No AI key required.
# BLENDER_BIN=C:\tools\blender\blender.exe
# VILLA_MAX_ATTEMPTS=32
# VILLA_BLENDER_THREADS=   (default: every CPU core)
# VILLA_PARALLEL=        (Blender candidates built at once; default: cores / 3, max 8)
# VILLA_CYCLES_DEVICE=AUTO
# VILLA_SIMILARITY_THRESHOLD=0.75

# IMAGE_ENGINE=gemini-web   # Gemini Web first for Render + AI Interior (default: local SDXL first)
