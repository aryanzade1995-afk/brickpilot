# Copy to server/.env and fill in. server/.env is gitignored.
# In production (Render) set these in the dashboard Environment tab instead.

# Google AI Studio key for Gemini 2.5 Flash Image ("Nano Banana"), free tier:
# https://aistudio.google.com/apikey
# Without it the render step still works — it echoes the massing reference.
GEMINI_API_KEY=

# Optional overrides
# RENDER_MODEL=gemini-2.5-flash-image
# RENDER_PROXY_PORT=8787          # local only; Render injects PORT itself

# Set to 1 to skip the API entirely and echo the massing reference back
# (useful for demoing the flow with no key)
# RENDER_MOCK=1
