{
  "4": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "%CKPT%" }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "%POSITIVE%", "clip": ["4", 1] }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "%NEGATIVE%", "clip": ["4", 1] }
  },
  "10": {
    "class_type": "LoadImage",
    "inputs": { "image": "%DEPTH%" }
  },
  "11": {
    "class_type": "LoadImage",
    "inputs": { "image": "%EDGE%" }
  },
  "12": {
    "class_type": "EmptyLatentImage",
    "inputs": { "width": "%WIDTH%", "height": "%HEIGHT%", "batch_size": 1 }
  },
  "20": {
    "class_type": "ControlNetLoader",
    "inputs": { "control_net_name": "%CN_DEPTH_MODEL%" }
  },
  "21": {
    "class_type": "ControlNetLoader",
    "inputs": { "control_net_name": "%CN_CANNY_MODEL%" }
  },
  "30": {
    "class_type": "ControlNetApplyAdvanced",
    "inputs": {
      "positive": ["5", 0],
      "negative": ["6", 0],
      "control_net": ["20", 0],
      "image": ["10", 0],
      "strength": "%CN_DEPTH_STR%",
      "start_percent": "0.0",
      "end_percent": "%CN_DEPTH_END%"
    }
  },
  "31": {
    "class_type": "ControlNetApplyAdvanced",
    "inputs": {
      "positive": ["30", 0],
      "negative": ["30", 1],
      "control_net": ["21", 0],
      "image": ["11", 0],
      "strength": "%CN_CANNY_STR%",
      "start_percent": "0.0",
      "end_percent": "%CN_CANNY_END%"
    }
  },
  "50": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["4", 0],
      "positive": ["31", 0],
      "negative": ["31", 1],
      "latent_image": ["12", 0],
      "seed": "%SEED%",
      "steps": "%STEPS%",
      "cfg": "%CFG%",
      "sampler_name": "%SAMPLER%",
      "scheduler": "%SCHEDULER%",
      "denoise": "%DENOISE%"
    }
  },
  "60": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["50", 0], "vae": ["4", 2] }
  },
  "70": {
    "class_type": "SaveImage",
    "inputs": { "images": ["60", 0], "filename_prefix": "brickpilot_interior" }
  }
}
